{
  "name": "schoolclerk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "bun ../local-infra-kit/bin/with-env.ts --profile school-clerk --mode prod -- turbo build",
    "build:dashboard": "bun ../local-infra-kit/bin/with-env.ts --profile school-clerk --mode prod -- turbo build --parallel --filter !@school-clerk/jobs --filter  !@school-clerk/api --filter !@school-clerk/marketing",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "db:generate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts generate --profile school-clerk",
    "db:migrate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts migrate --profile school-clerk",
    "db:pull": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts pull --profile school-clerk",
    "db:push": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts push --profile school-clerk",
    "db:studio": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts studio --profile school-clerk",
    "db:sync": "bun --env-file=/dev/null ../local-infra-kit/bin/db-sync.ts --profile school-clerk",
    "db:docker:up": "bun run dev:services:local",
    "db:docker:down": "docker compose -f docker-compose.yml down",
    "db:start": "bun run dev:services:local",
    "db:shell": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts shell --profile school-clerk",
    "dev:prepare": "bun run kill:ports && bun run dev:services",
    "dev:services": "bun ../local-infra-kit/bin/dev-services.ts --profile school-clerk",
    "dev:services:local": "bun ../local-infra-kit/bin/dev-services.ts --profile school-clerk --mode local",
    "dev:services:local-db": "bun ../local-infra-kit/bin/dev-services.ts --profile school-clerk --mode local",
    "dev": "bun ../local-infra-kit/bin/dev.ts --profile school-clerk",
    "jobs:deploy": "bun run --filter @school-clerk/jobs deploy",
    "terminal": "bash ./scripts/open-bun-script-terminal.sh",
    "format": "turbo format --continue -- --cache --cache-location='node_modules/.cache/.prettiercache' --ignore-path='../../.gitignore'",
    "format:fix": "turbo format --continue -- --write --cache --cache-location='node_modules/.cache/.prettiercache' --ignore-path='../../.gitignore'",
    "lint": "turbo lint -- --quiet -- --cache --cache-location 'node_modules/.cache/.eslintcache' && manypkg check",
    "kill:ports": "bun ../local-infra-kit/bin/kill-ports.ts --profile school-clerk",
    "lint:fix": "turbo lint --continue -- --fix --cache --cache-location 'node_modules/.cache/.eslintcache' ",
    "typecheck": "turbo typecheck",
    "--postinstall": "bun run check-deps",
    "check-deps": "check-dependency-version-consistency .",
    "gen": "turbo gen --config 'turbo/generators/config.ts'"
  },
  "dependencies": {
    "@biomejs/biome": "1.9.4",
    "@manypkg/cli": "^0.24.0",
    "turbo": "2.5.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@turbo/gen": "2.5.4",
    "@types/node": "^24.7.2",
    "check-dependency-version-consistency": "4.1.0",
    "knip": "^5.61.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.16"
}
