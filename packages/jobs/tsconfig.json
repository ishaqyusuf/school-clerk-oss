{
  "extends": "@school-clerk/tsconfig/base.json",
  "include": ["src", "../../types"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@jobs/*": ["src/*"],
      "@api/*": ["../../apps/api/src/*"]
    },
    "jsx": "react-jsx"
  }
}
