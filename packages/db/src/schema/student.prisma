model Students {
    id                 String                      @id @default(uuid())
    name               String
    surname            String?
    otherName          String?
    createdAt          DateTime?                   @default(now()) @db.Timestamp(0)
    updatedAt          DateTime?                   @updatedAt
    deletedAt          DateTime?                   @db.Timestamp(0)
    dob                DateTime?                   @db.Timestamp(0)
    gender             Gender
    schoolProfile      SchoolProfile?              @relation(fields: [schoolProfileId], references: [id])
    schoolProfileId    String?
    sessionForms       StudentSessionForm[]
    termForms          StudentTermForm[]
    guardians          StudentGuardians[]
    assessmentRecords  StudentAssessmentRecord[]
    notificationContact NotificationContact?
    financeCharges     FinanceCharge[]
    financePayments    FinancePayment[]
    withdrawals        StudentWithdrawal[]

    @@unique([name, surname, otherName, schoolProfileId, deletedAt])
}

model StudentGuardians {
    id          String    @id @default(uuid())
    guardian    Guardians @relation(fields: [guardiansId], references: [id])
    guardiansId String
    relation    String?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    student   Students? @relation(fields: [studentId], references: [id])
    studentId String
}

enum Gender {
    Male
    Female
}

enum StudentTermAdmissionType {
    UNCLASSIFIED
    NEW_ADMISSION
    RETURNING
}

enum StudentRegistrationReviewStatus {
    APPROVED
    PENDING
    REJECTED
}

model StudentSessionForm {
    id                    String               @id @default(uuid())
    student               Students?            @relation(fields: [studentId], references: [id])
    studentId             String?
    createdAt             DateTime?            @default(now()) @db.Timestamp(0)
    updatedAt             DateTime?            @updatedAt
    deletedAt             DateTime?            @db.Timestamp(0)
    schoolSession         SchoolSession?       @relation(fields: [schoolSessionId], references: [id])
    schoolSessionId       String?
    schoolProfile         SchoolProfile?       @relation(fields: [schoolProfileId], references: [id])
    schoolProfileId       String?
    termForms             StudentTermForm[]
    classroomDepartment   ClassRoomDepartment? @relation(fields: [classroomDepartmentId], references: [id])
    classroomDepartmentId String?
}

model StudentTermForm {
    id                String                    @id @default(uuid())
    schoolProfile     SchoolProfile?            @relation(fields: [schoolProfileId], references: [id])
    schoolProfileId   String?
    createdAt         DateTime?                 @default(now()) @db.Timestamp(0)
    updatedAt         DateTime?                 @updatedAt
    deletedAt         DateTime?                 @db.Timestamp(0)
    sessionTerm       SessionTerm?              @relation(fields: [sessionTermId], references: [id])
    sessionTermId     String?
    schoolSession     SchoolSession?            @relation(fields: [schoolSessionId], references: [id])
    schoolSessionId   String?
    attendanceList    StudentAttendance[]
    assessmentRecords StudentAssessmentRecord[]

    studentSessionFormId String
    sessionForm          StudentSessionForm @relation(fields: [studentSessionFormId], references: [id])

    student   Students? @relation(fields: [studentId], references: [id])
    studentId String?

    classroomDepartment   ClassRoomDepartment? @relation(fields: [classroomDepartmentId], references: [id])
    classroomDepartmentId String?
    admissionType          StudentTermAdmissionType @default(UNCLASSIFIED)
    registrationReviewStatus StudentRegistrationReviewStatus @default(APPROVED)
    registrationRequestedByUserId String?
    registrationReviewedByUserId String?
    registrationReviewedAt DateTime? @db.Timestamp(0)
    registrationReviewNote String?
    financeCharges        FinanceCharge[]

    @@index([schoolProfileId, sessionTermId, admissionType])
    @@index([schoolProfileId, registrationReviewStatus, sessionTermId])
}

/// One withdrawal period. The student stays enrolled through `lastEnrolledDate`;
/// the period stays open until a readmission closes it. Withdrawal never
/// deletes the profile, enrollments, results, attendance, charges or payments
/// and is independent of deletion, admission type and registration approval.
model StudentWithdrawal {
    id                 String        @id @default(uuid())
    schoolProfile      SchoolProfile @relation(fields: [schoolProfileId], references: [id])
    schoolProfileId    String
    student            Students      @relation(fields: [studentId], references: [id])
    studentId          String
    withdrawalTerm     SessionTerm   @relation("StudentWithdrawalTerm", fields: [withdrawalTermId], references: [id])
    withdrawalTermId   String
    lastEnrolledDate   DateTime      @db.Timestamp(0)
    reason             String
    note               String?
    withdrawnByUserId  String
    /// Snapshot of future-term enrollments archived or flagged for review.
    reconciliation     Json?
    readmissionTerm    SessionTerm?  @relation("StudentReadmissionTerm", fields: [readmissionTermId], references: [id])
    readmissionTermId  String?
    readmittedOn       DateTime?     @db.Timestamp(0)
    readmissionNote    String?
    readmittedByUserId String?
    readmittedAt       DateTime?     @db.Timestamp(0)
    createdAt          DateTime      @default(now()) @db.Timestamp(0)
    updatedAt          DateTime      @updatedAt

    @@index([schoolProfileId, studentId])
    @@index([schoolProfileId, readmittedAt])
}
