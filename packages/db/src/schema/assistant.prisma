model AssistantConversation {
    id              String   @id @default(cuid())
    schoolProfileId String
    createdByUserId String
    title           String?
    locale          String?
    status          AssistantConversationStatus @default(active)
    summary         String?
    lastMessageAt   DateTime? @db.Timestamp(0)
    meta            Json?
    protocolVersion Int @default(1)
    nextSequence Int @default(0)

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    schoolProfile SchoolProfile @relation(fields: [schoolProfileId], references: [id])
    createdBy    User          @relation("AssistantConversationCreatedBy", fields: [createdByUserId], references: [id])
    proposals AssistantActionProposal[]
    attachments AssistantAttachment[]
    artifacts AssistantArtifact[]
    messages     AssistantMessage[]
    runs         AssistantRun[]
    feedback     AssistantFeedback[]
    toolExecutions AssistantToolExecution[]

    @@index([schoolProfileId, createdByUserId, lastMessageAt])
}

model AssistantMessage {
    id              String   @id @default(cuid())
    conversationId  String
    schoolProfileId String
    createdByUserId String?
    role            AssistantMessageRole
    content         String?
    parts           Json?
    workflowState   Json?
    sequence Int?
    requestKey String?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    schoolProfile SchoolProfile         @relation(fields: [schoolProfileId], references: [id])
    createdBy     User?                 @relation("AssistantMessageCreatedBy", fields: [createdByUserId], references: [id])

    @@index([conversationId, sequence])
    @@index([conversationId, requestKey])
    @@index([conversationId, createdAt])
    @@index([schoolProfileId, role, createdAt])
}

model AssistantRun {
    id              String   @id @default(cuid())
    conversationId  String
    schoolProfileId String
    userId          String
    status          AssistantRunStatus @default(running)
    provider        String?
    model           String?
    requestType     String?
    locale          String?
    promptSummary   String?
    usage           Json?
    metrics         Json?
    error           String?
    workflowAction  Json?
    requestKeyRecord AssistantRunRequest?
    usageReservation AssistantUsageReservation?
    proposals AssistantActionProposal[]
    requestId String?
    fingerprint String?
    deadlineAt DateTime?
    completedAt DateTime?
    cancelRequested Boolean @default(false)

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    conversation   AssistantConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    schoolProfile  SchoolProfile           @relation(fields: [schoolProfileId], references: [id])
    user           User                    @relation("AssistantRunUser", fields: [userId], references: [id])
    toolExecutions AssistantToolExecution[]
    feedback       AssistantFeedback[]

    @@index([conversationId, createdAt])
    @@index([schoolProfileId, userId, requestId])
    @@index([schoolProfileId, status, createdAt])
}

model AssistantToolExecution {
    id              String   @id @default(cuid())
    runId           String
    conversationId  String
    schoolProfileId String
    toolName        String
    capability      String?
    status          AssistantToolExecutionStatus @default(started)
    isMutation      Boolean @default(false)
    toolVersion Int @default(1)
    input           Json?
    output          Json?
    error           String?
    startedAt       DateTime? @default(now()) @db.Timestamp(0)
    completedAt     DateTime? @db.Timestamp(0)

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    run          AssistantRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
    conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    schoolProfile SchoolProfile        @relation(fields: [schoolProfileId], references: [id])

    @@index([runId, createdAt])
    @@index([schoolProfileId, toolName, createdAt])
}

model SchoolAssistantConfig {
    id                 String  @id @default(cuid())
    schoolProfileId    String  @unique
    enabled            Boolean @default(true)
    preferredProvider  String?
    preferredModel     String?
    allowedRoles       Json?
    enabledCapabilities Json?
    disabledCapabilities Json?
    analyticsEnabled   Boolean @default(true)
    feedbackEnabled    Boolean @default(true)
    maxSteps           Int     @default(5)
    dailyRequestLimit Int @default(100)
    dailyTokenLimit Int @default(1000000)
    concurrentRunLimit Int @default(1)
    systemPromptExtra  String?
    rolloutStage       String?
    featureFlags       Json?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    schoolProfile SchoolProfile @relation(fields: [schoolProfileId], references: [id], onDelete: Cascade)
}

model AssistantFeedback {
    id              String   @id @default(cuid())
    schoolProfileId String
    userId          String
    conversationId  String?
    runId           String?
    rating          Int?
    comment         String?
    meta            Json?

    createdAt DateTime? @default(now()) @db.Timestamp(0)
    updatedAt DateTime? @updatedAt
    deletedAt DateTime? @db.Timestamp(0)

    schoolProfile SchoolProfile         @relation(fields: [schoolProfileId], references: [id])
    user         User                   @relation("AssistantFeedbackUser", fields: [userId], references: [id])
    conversation AssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    run          AssistantRun?          @relation(fields: [runId], references: [id], onDelete: Cascade)

    @@index([schoolProfileId, createdAt])
}

enum AssistantConversationStatus {
    active
    archived
}

enum AssistantMessageRole {
    user
    assistant
    system
}

enum AssistantRunStatus {
    running
    completed
    failed
    cancelled
}

enum AssistantToolExecutionStatus {
    started
    completed
    blocked
    failed
}

// All queries enforce school + user + owned conversation; IDs are never authority.
model AssistantActionProposal {
    id String @id @default(cuid())
    schoolProfileId String
    userId String
    conversationId String
    runId String
    toolName String
    toolVersion Int @default(1)
    payload Json
    summary String
    token String
    revision String
    sessionId String?
    termId String?
    status String @default("pending")
    result Json?
    expiresAt DateTime
    createdAt DateTime @default(now())
    completedAt DateTime?
    @@index([schoolProfileId, userId, conversationId])
    conversation AssistantConversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
    run AssistantRun @relation(fields:[runId], references:[id], onDelete:Cascade)
}
model AssistantPreference {
    id String @id @default(cuid())
    schoolProfileId String
    userId String
    locale String @default("auto")
    savedPrompts Json @default("[]")
    @@unique([schoolProfileId, userId])
    schoolProfile SchoolProfile @relation(fields:[schoolProfileId], references:[id], onDelete:Cascade)
    user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model AssistantUsageReservation {
    id String @id
    schoolProfileId String
    userId String
    day String
    reservedTokens Int
    actualTokens Int?
    status String @default("reserved")
    createdAt DateTime @default(now())
    @@index([schoolProfileId, userId, day])
    run AssistantRun @relation(fields:[id], references:[id], onDelete:Cascade)
}
model AssistantAttachment {
    id String @id @default(cuid())
    schoolProfileId String
    userId String
    conversationId String
    name String
    mediaType String
    size Int
    status String @default("ready")
    text String?
    storageKey String?
    bytes Bytes?
    createdAt DateTime @default(now())
    deletedAt DateTime?
    @@index([schoolProfileId, userId, conversationId])
    conversation AssistantConversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
}
model AssistantArtifact {
    id String @id @default(cuid())
    schoolProfileId String
    userId String
    conversationId String
    title String
    kind String
    status String @default("ready")
    content Json
    bytes Bytes?
    authSessionId String?
    error String?
    createdAt DateTime @default(now())
    @@index([schoolProfileId, userId, conversationId])
    conversation AssistantConversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
}

// New protocol keys avoid retroactive constraints on historical runs.
model AssistantRunRequest {
 id String @id @default(uuid())
 schoolProfileId String
 userId String
 requestId String
 runId String @unique
 fingerprint String
 @@unique([schoolProfileId, userId, requestId])
    run AssistantRun @relation(fields:[runId], references:[id], onDelete:Cascade)
}
