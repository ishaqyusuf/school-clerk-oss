model Activity {
  id              String         @id @default(uuid())
  userId          String
  title           String?
  description     String?
  author          String
  source          ActivitySource
  type            ActivityType
  meta            Json?
  /// Primary entity this activity is about ("student", "classroom", "payment",
  /// "attendance", "term"...), for per-entity history. See ADR-0093.
  subjectType     String?
  subjectId       String?
  /// Set once notification fan-out has claimed this activity (post-commit).
  notifiedAt      DateTime?      @db.Timestamp(0)
  createdAt       DateTime?      @default(now()) @db.Timestamp(0)
  updatedAt       DateTime?      @updatedAt
  deletedAt       DateTime?      @db.Timestamp(0)
  schoolProfile   SchoolProfile? @relation(fields: [schoolProfileId], references: [id])
  schoolProfileId String?

  @@index([schoolProfileId, createdAt])
  @@index([schoolProfileId, userId, createdAt])
  @@index([schoolProfileId, type, createdAt])
  @@index([schoolProfileId, subjectType, subjectId])
  @@index([schoolProfileId, notifiedAt])
}

/// Opt-in notification rule for one activity type. No row (or enabled=false)
/// means the activity is recorded and visible on /activity but never notifies.
model ActivityNotificationRule {
  id              String        @id @default(uuid())
  schoolProfileId String
  type            ActivityType
  enabled         Boolean       @default(false)
  inApp           Boolean       @default(true)
  email           Boolean       @default(false)
  /// Lower-case role names (admin, accountant, hr, teacher, registrar...).
  roles           String[]      @default([])
  /// Specific User ids notified in addition to the roles.
  userIds         String[]      @default([])
  updatedByUserId String?
  createdAt       DateTime      @default(now()) @db.Timestamp(0)
  updatedAt       DateTime      @updatedAt

  schoolProfile SchoolProfile @relation(fields: [schoolProfileId], references: [id], onDelete: Cascade)

  @@unique([schoolProfileId, type])
}

enum ActivitySource {
  user
  system
}

enum ActivityType {
  wallet_created

  student_fee_created
  student_fee_cancelled

  // student payment transaction activities
  student_payment_received
  student_payment_refund
  student_payment_cancelled

  student_payment_transaction_cancelled
  student_payment_transaction_created
  finance_payment_import_created
  finance_payment_import_completed
  finance_payment_import_retried
  finance_payment_import_row_failed

  student_term_created
  student_term_cancelled

  student_withdrawn
  student_readmitted

  student_created
  student_enrolled
  student_class_changed
  student_deleted
  student_payment_reversed
  students_promoted

  assistant_run
  assistant_action_requested
  assistant_action_completed
  assistant_action_blocked

  assessment_public_link_created
  assessment_public_link_requested
  assessment_public_link_approved
  assessment_public_link_rejected
  assessment_public_link_revoked
  assessment_public_link_score_recorded

  assessment_workbook_downloaded
  assessment_workbook_imported

  academic_term_setup_completed
  academic_term_activated
  academic_term_closed

  attendance_created
  attendance_updated
  attendance_deleted
}
