{
  "name": "@school-clerk/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "rm -rf .cache dist tsc",
    "clean": "rm -rf .turbo node_modules",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:studio": "prisma studio --port 5556",
    "db:sync": "bun scripts/sync-databases.ts",
    "with-env": "bun ../../../local-infra-kit/bin/with-env.ts --profile school-clerk --mode local --"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@t3-oss/env-core": "^0.11.1",
    "date-fns": "^4.1.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@school-clerk/tsconfig": "workspace:*",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.2",
    "prisma": "^7.8.0",
    "typescript": "^5.9.2"
  }
}
